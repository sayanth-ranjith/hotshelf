<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>io.github.sayanth-ranjith</groupId>
	<artifactId>hotshelf</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>hotshelf</name>
	<description>A lightweight in-memory cache for Java, built from scratch to understand how caches work.</description>
	<url>https://github.com/sayanth-ranjith/hotshelf</url>

	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>sayanth-ranjith</id>
			<name>Sayanth</name>
			<url>https://github.com/sayanth-ranjith</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/sayanth-ranjith/hotshelf.git</connection>
		<developerConnection>scm:git:https://github.com/sayanth-ranjith/hotshelf.git</developerConnection>
		<url>https://github.com/sayanth-ranjith/hotshelf</url>
		<tag>HEAD</tag>
	</scm>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!--
		hotshelf is a library: users must not get Spring just by depending on it.
		Every dependency stays test-scoped until the Spring auto-configuration arrives (v3), which will use
		<optional>true</optional>. No spring-boot-maven-plugin: it would repackage this jar into an
		executable app that other projects cannot depend on.
	-->
	<dependencies>
		<!-- For the demo app in src/test that shows hotshelf used as a Spring bean. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- JUnit 5, AssertJ and Spring's test support. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
